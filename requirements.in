# Top-level runtime dependencies. Regenerate the pinned files with:
#   uv pip compile requirements.in --python-version 3.12 --upgrade -o requirements.txt
#   uv pip compile requirements-dev.in --python-version 3.12 --upgrade -o requirements-dev.txt
alembic
boto3
# [redis]: the Redis/Valkey broker of the systemd install (MOTUZ_CELERY_BROKER_URL=redis+socket://...)
celery[redis]
# AES-256-GCM and HKDF for the encrypted credential columns (api/utils/secret_box.py) and
# rclone's password obscuring (api/utils/rclone_obscure.py)
cryptography
Flask
Flask-JWT-Extended
Flask-Migrate
flask-restx
Flask-SQLAlchemy
psycopg[binary]
SQLAlchemy
uWSGI
# Decode-only HEIC/HEIF (no x265 encoder; libheif + libde265, LGPL-3.0, as bundled shared libraries)
# for the image viewer, run as the logged-in user in a child process: api/utils/heic_convert.py
pi-heif
Pillow
