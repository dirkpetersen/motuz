# Configuration of motuz-worker (~/.config/motuz-worker/worker.env of the motuz account,
# read by motuz-worker.service). README, "Remote workers (HTTPS only)".

# The Motuz checkout on this worker: the same release as the central node
MOTUZ_HOME=/opt/motuz

# The central node; the only address this worker connects to (HTTPS, port 443)
MOTUZ_CENTRAL_URL=https://motuz.example.org

# The worker secret printed by `manage.py workers add <name> --pool onprem` (mode 600)
MOTUZ_WORKER_CREDENTIAL_FILE=/home/motuz/.config/motuz-worker/credential

# Optional: refuse to start if the credential belongs to another pool
MOTUZ_WORKER_POOL=onprem

# File systems that must be mounted before this worker claims jobs (comma separated)
MOTUZ_REQUIRED_PATHS=/home

# Optional HTTP proxy (CONNECT) for the worker and rclone
#HTTPS_PROXY=http://proxy.example.org:3128
#NO_PROXY=localhost,127.0.0.1

# Optional CA bundle (PEM) for the central node's certificate and for rclone
# (SSL_CERT_FILE). It replaces the system's roots, so it must contain them too, e.g.
#   cat /etc/ssl/certs/ca-certificates.crt our-ca.pem > /home/motuz/.config/motuz-worker/ca.pem
#MOTUZ_CA_BUNDLE=/home/motuz/.config/motuz-worker/ca.pem

# Job types this worker runs (default both)
#MOTUZ_WORKER_JOB_TYPES=copy,hashsum
