{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(bin/systemd/deploy.sh:*)",
      "Bash(~/motuz/bin/systemd/deploy.sh:*)",
      "Bash(bin/systemd/config.sh show)",
      "Bash(bin/systemd/config.sh set:*)",
      "Bash(systemctl --user status:*)",
      "Bash(systemctl --user list-units:*)",
      "Bash(systemctl --user is-active:*)",
      "Bash(ss -ltn:*)",
      "Bash(ss -ltnp:*)",
      "Bash(bin/systemd/smoke_test.py:*)",
      "Bash(curl -sk https://127.0.0.1/api/system/info/)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(doas:*)",
      "Bash(pkexec:*)",
      "Bash(run0:*)",
      "Bash(machinectl:*)",
      "Bash(visudo:*)",
      "Bash(*/etc/sudoers*)",
      "Bash(*/etc/pam.d*)",
      "Bash(*secrets.env*)",
      "Bash(*broker.env*)",
      "Bash(*handoff.env*)",
      "Bash(*redis.conf*)",
      "Bash(*claude.ai/install.sh*)",
      "Bash(curl * | *)",
      "Bash(wget * | *)",
      "Bash(* | bash*)",
      "Bash(* | sh*)",
      "Read(~/.config/motuz/secrets.env)",
      "Read(~/.config/motuz/broker.env)",
      "Read(~/.config/motuz/handoff.env)",
      "Read(~/.config/motuz/redis.conf)",
      "Read(~/data/certs/cert.key)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.config/motuz/secrets.env)",
      "Edit(~/.config/motuz/broker.env)",
      "Edit(~/.config/motuz/handoff.env)",
      "Edit(~/.config/motuz/redis.conf)",
      "Edit(~/.claude/**)",
      "Edit(~/.ssh/**)"
    ]
  }
}
