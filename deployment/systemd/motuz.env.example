# Motuz settings of the systemd install (bin/systemd/deploy.sh copies this file to
# ~/.config/motuz/motuz.env on the first deploy and never changes it afterwards).
# Secrets are in ~/.config/motuz/secrets.env (mode 600). After changes:
#     systemctl --user restart motuz.target
# systemd EnvironmentFile syntax: KEY=value, or KEY="value with spaces"; no $ expansion.
# The settings are those of .env / docker-compose.yml of the docker install.

# Mount points the worker must see before it runs jobs (commas or colons; the same
# setting as a remote worker's worker.env). The worker does not start without them
# (motuz-celery.service retries every 30 s), and a job fails with the reason instead of
# running on a half-mounted tree.
#MOTUZ_REQUIRED_PATHS=/fh/fast,/fh/scratch

# The database. MOTUZ_DATABASE_MODE (written by deploy.sh from what install.sh prepared;
# README, "Why a private PostgreSQL cluster?"):
#   system    the distribution's PostgreSQL 18 service (install.sh --system-postgres, the
#             default on Ubuntu): role motuz_user and database motuz; MOTUZ_DATABASE_HOST
#             is its localhost address
#   private   the cluster ~/data/pg of the user service motuz-postgres on 127.0.0.1:5432
#             (--private-postgres, the default on Amazon Linux)
#   external  another server: set MOTUZ_DATABASE_HOST/_USER/_NAME here and
#             MOTUZ_DATABASE_PASSWORD in secrets.env (create the database and role there,
#             owned by the role); no local PostgreSQL unit is installed or started
# The Celery broker, MOTUZ_BROKER_MODE: system (the distribution's Redis on its unix
# socket MOTUZ_REDIS_SOCKET, ACL user motuz; --system-redis, default on Ubuntu) or
# private (the user service motuz-redis; --private-redis, default on Amazon Linux).
# An existing install keeps its modes; deploy.sh writes them below on the first run.
#MOTUZ_DATABASE_MODE=system
#MOTUZ_BROKER_MODE=system
MOTUZ_DATABASE_PROTOCOL=postgresql
MOTUZ_DATABASE_NAME=motuz
MOTUZ_DATABASE_USER=motuz_user
MOTUZ_DATABASE_HOST=127.0.0.1:5432
MOTUZ_DATABASE_REQUIRE_SSL=false

# Job notification emails (the password is MOTUZ_SMTP_PASSWORD in secrets.env)
MOTUZ_SMTP_SERVER=0.0.0.0:465
MOTUZ_SMTP_REQUIRE_SSL=true
MOTUZ_SMTP_USER=
#MOTUZ_ALERT_ADDRESS=

# Logins: PAM service /etc/pam.d/motuz (installed by install.sh; SSSD/Kerberos work in
# the app itself). Local /etc/shadow accounts need the login helper of
# `install.sh --local-accounts`; deploy.sh sets this when the helper's socket exists.
MOTUZ_PAM_SERVICE=motuz
#MOTUZ_AUTH_HELPER=/run/motuz-auth.sock

# AWS SSO configs for rclone (created by install.sh; not /tmp, which every user can write)
MOTUZ_SSO_CONFIG_DIR=/var/lib/motuz-aws-config

# HTTPS (README, "Set up HTTPS certificate"): by default Traefik uses
# ~/data/certs/cert.crt and cert.key (deploy.sh makes a self-signed one if missing). Set
# MOTUZ_ACME_DOMAIN to this host's public DNS name for Let's Encrypt (port 80 must be
# reachable), then run deploy.sh again (it writes Traefik's flags).
#MOTUZ_ACME_DOMAIN=motuz.example.org
#MOTUZ_ACME_EMAIL=admin@example.org

# Own OneDrive app / Google OAuth client (README); the client secrets are
# MOTUZ_ONEDRIVE_CLIENT_SECRET / MOTUZ_GDRIVE_CLIENT_SECRET in secrets.env
#MOTUZ_ONEDRIVE_CLIENT_ID=00000000-0000-0000-0000-000000000000
#MOTUZ_ONEDRIVE_REDIRECT_URI=https://motuz.example.org/api/oauth/onedrive/callback
#MOTUZ_GDRIVE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
#MOTUZ_GDRIVE_REDIRECT_URI=https://motuz.example.org/api/oauth/gdrive/callback

# rclone performance (README, "Performance tuning"; the same settings as .env of the
# docker install). Unset or empty: Motuz's 16 transfers and 32 checkers (lowered to the
# MAX_* caps, skipped if they do not fit the memory budget), rclone's own defaults for the
# rest (4 multi-thread streams above 256M, 16M buffer, S3 5M chunks x 4, Azure 4M x 16).
# Users can override transfers, checkers, streams, cutoff and the S3/Azure chunk settings
# per job, up to the MAX_* caps and the memory budget per job:
#   transfers * (max(1, streams) * buffer_size + max(upload_concurrency, streams) * chunk_size)
# Sizes use rclone's binary units with a unit: 64M, 1G. Invalid values stop the app and
# the worker at startup with a message naming the variable.
#MOTUZ_RCLONE_TRANSFERS=16
#MOTUZ_RCLONE_CHECKERS=32
#MOTUZ_RCLONE_MULTI_THREAD_STREAMS=8
#MOTUZ_RCLONE_MULTI_THREAD_CUTOFF=128M
# unset: 0 for copy jobs from a local source (no read-ahead), rclone's 16M otherwise
#MOTUZ_RCLONE_BUFFER_SIZE=16M
#MOTUZ_RCLONE_S3_UPLOAD_CONCURRENCY=8
#MOTUZ_RCLONE_S3_CHUNK_SIZE=32M
#MOTUZ_RCLONE_AZUREBLOB_UPLOAD_CONCURRENCY=16
#MOTUZ_RCLONE_AZUREBLOB_CHUNK_SIZE=16M
# Caps for per-job values (defaults shown) and the memory budget per job (default 8G)
#MOTUZ_RCLONE_MAX_TRANSFERS=64
#MOTUZ_RCLONE_MAX_CHECKERS=128
#MOTUZ_RCLONE_MAX_MULTI_THREAD_STREAMS=32
#MOTUZ_RCLONE_MAX_UPLOAD_CONCURRENCY=64
#MOTUZ_RCLONE_MEMORY_BUDGET=8G
# md5-simd servers for rclone's MD5s (default 2, 0 = off; needs the rclone build of README
# "S3 connections", a stock rclone ignores it)
#MOTUZ_RCLONE_MD5_SIMD_SERVERS=2
# Admin-only extra flags, from an allowlist (README): --fast-list, --use-mmap,
# --no-traverse, --disable-http2, --s3-disable-http2, --max-buffer-memory=SIZE,
# --multi-thread-chunk-size=SIZE, --multi-thread-write-buffer-size=SIZE,
# --s3-upload-cutoff=SIZE, --s3-copy-cutoff=SIZE, --low-level-retries=N, --retries=N
#MOTUZ_RCLONE_EXTRA_FLAGS="--max-buffer-memory=32G --use-mmap"

# Overwriting existing files (README, "Overwriting existing files"). Unset or false: copy
# jobs and uploads overwrite existing files only within destinations that a Motuz copy
# (by any user) wrote before; elsewhere existing files are kept and only new ones copied.
# true: changed files are overwritten wherever the user may write (the behaviour before).
#MOTUZ_ALLOW_GENERAL_OVERWRITES=false

# Largest image the file viewer shows (README, "File viewer"; default 25M, at most 256M)
#MOTUZ_VIEW_IMAGE_MAX_BYTES=25M

# HEIC/HEIF images are converted to JPEG for browsers that cannot show them, by a child
# process run as the logged-in user (README, "File viewer"): an interpreter every user can
# run and a directory with pi-heif and Pillow for it. deploy.sh sets both when
# install.sh installed /opt/motuz-heic.
#MOTUZ_HEIC_PYTHON=/usr/bin/python3
#MOTUZ_HEIC_SITE=/opt/motuz-heic/site
# How many conversions run at once (1 to 16, default 2; each may use 2 GiB of address space)
#MOTUZ_HEIC_MAX_CONCURRENT=2

# Operator shown on /privacy and /terms (README, "Privacy policy and terms")
#MOTUZ_OPERATOR_NAME="Example Research Institute"
#MOTUZ_CONTACT_EMAIL=motuz-admin@example.org
#MOTUZ_OPERATOR_URL=https://www.example.org/
