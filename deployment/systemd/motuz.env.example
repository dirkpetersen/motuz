# Motuz settings of the systemd install (bin/systemd/deploy.sh copies this file to
# ~/.config/motuz/motuz.env on the first deploy and never changes it afterwards).
# Secrets are in ~/.config/motuz/secrets.env (mode 600). After changes:
#     systemctl --user restart motuz.target
# systemd EnvironmentFile syntax: KEY=value, or KEY="value with spaces"; no $ expansion.
# The settings are those of .env / docker-compose.yml of the docker install.

# Storage the worker must see before it runs jobs: directories (MOTUZ_REQUIRED_PATHS) and
# mount points (MOTUZ_REQUIRED_MOUNTS), colon-separated. The worker does not start without
# them (motuz-celery.service retries every 30 s), and a job fails with the reason instead
# of running on a half-mounted tree.
#MOTUZ_REQUIRED_PATHS=/home
#MOTUZ_REQUIRED_MOUNTS=/fh/fast:/fh/scratch

# The local cluster of motuz-postgres.service (keep these unless you use an external database)
MOTUZ_DATABASE_PROTOCOL=postgresql
MOTUZ_DATABASE_NAME=motuz
MOTUZ_DATABASE_USER=motuz_user
MOTUZ_DATABASE_HOST=127.0.0.1:5432
MOTUZ_DATABASE_REQUIRE_SSL=false

# Job notification emails (the password is MOTUZ_SMTP_PASSWORD in secrets.env)
MOTUZ_SMTP_SERVER=0.0.0.0:465
MOTUZ_SMTP_REQUIRE_SSL=true
MOTUZ_SMTP_USER=
#MOTUZ_ALERT_ADDRESS=

# Logins: PAM service /etc/pam.d/motuz (installed by install.sh; SSSD/Kerberos work in
# the app itself). Local /etc/shadow accounts need the login helper of
# `install.sh --local-accounts`; deploy.sh sets this when the helper's socket exists.
MOTUZ_PAM_SERVICE=motuz
#MOTUZ_AUTH_HELPER=/run/motuz-auth.sock

# AWS SSO configs for rclone (created by install.sh; not /tmp, which every user can write)
MOTUZ_SSO_CONFIG_DIR=/var/lib/motuz-aws-config

# HTTPS (README, "Set up HTTPS certificate"): by default Traefik uses
# ~/data/certs/cert.crt and cert.key (deploy.sh makes a self-signed one if missing). Set
# MOTUZ_ACME_DOMAIN to this host's public DNS name for Let's Encrypt (port 80 must be
# reachable), then run deploy.sh again (it writes Traefik's flags).
#MOTUZ_ACME_DOMAIN=motuz.example.org
#MOTUZ_ACME_EMAIL=admin@example.org

# Own OneDrive app / Google OAuth client (README); the client secrets are
# MOTUZ_ONEDRIVE_CLIENT_SECRET / MOTUZ_GDRIVE_CLIENT_SECRET in secrets.env
#MOTUZ_ONEDRIVE_CLIENT_ID=00000000-0000-0000-0000-000000000000
#MOTUZ_ONEDRIVE_REDIRECT_URI=https://motuz.example.org/api/oauth/onedrive/callback
#MOTUZ_GDRIVE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
#MOTUZ_GDRIVE_REDIRECT_URI=https://motuz.example.org/api/oauth/gdrive/callback

# Operator shown on /privacy and /terms (README, "Privacy policy and terms")
#MOTUZ_OPERATOR_NAME="Example Research Institute"
#MOTUZ_CONTACT_EMAIL=motuz-admin@example.org
#MOTUZ_OPERATOR_URL=https://www.example.org/
