# Motuz without docker: user services of the `motuz` account (README, "Install (default:
# without Docker)"). bin/systemd/deploy.sh copies these units to ~/.config/systemd/user/.
# PostgreSQL and Redis units (motuz-postgres, motuz-redis) exist only in the private modes
# and are wired in by drop-ins that deploy.sh writes.
#   systemctl --user status 'motuz*'          systemctl --user restart motuz.target
[Unit]
Description=Motuz (uWSGI app, Celery worker, Traefik)
Wants=motuz-app.service motuz-celery.service motuz-traefik.service

[Install]
WantedBy=default.target
