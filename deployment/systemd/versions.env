# Pinned downloads of the systemd install (bin/systemd/install.sh, deploy.sh), checked
# by SHA256. rclone is pinned in deployment/docker/app/Dockerfile (RCLONE_VERSION,
# RCLONE_SHA256_*), which install.sh reads, so both installs use the same rclone.

# Traefik, the release of the traefik:v3.7 image used by docker-compose.yml
# https://github.com/traefik/traefik/releases (traefik_v<version>_checksums.txt)
TRAEFIK_VERSION=3.7.13
TRAEFIK_SHA256_AMD64=52cd039a34258dd61c617a95d69252bc6bcae27c520f338186c31c7fef8f6394
TRAEFIK_SHA256_ARM64=9155048abd64c59000d2f3c07dc6d6919bc6be9b618e6a554bc3808338aaf8b8

# uv, which installs the Python below (a python-build-standalone build; uv checks its
# SHA256) and the packages of requirements.txt into ~/motuz/venv
# https://github.com/astral-sh/uv/releases (uv-<target>.tar.gz.sha256)
UV_VERSION=0.12.19
UV_SHA256_AMD64=23bf5552d220e0842b65c862097b2ebaeba0064b74eda5e565e77fd25969d8c8
UV_SHA256_ARM64=0804e9b164c64b6914182d5920c08551958a095986f10a3731056df701126436

# The Python of the docker image (python:3.12-slim-bookworm), for which requirements.txt
# is compiled. Ubuntu 26.04's own python3 (3.14) runs only the scripts and the login helper.
PYTHON_VERSION=3.12
