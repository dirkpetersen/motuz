#!/usr/bin/env bash

# Default values used by docker-compose.yml
# https://docs.docker.com/compose/environment-variables/
# Run `docker-compose config` to see substitutions

MOTUZ_DATABASE_PROTOCOL=postgresql
MOTUZ_DATABASE_NAME=motuz
MOTUZ_DATABASE_HOST=0.0.0.0:5432
MOTUZ_DATABASE_USER=motuz_user
MOTUZ_DATABASE_REQUIRE_SSL=false

MOTUZ_SMTP_SERVER=0.0.0.0:465
MOTUZ_SMTP_REQUIRE_SSL=true
MOTUZ_SMTP_USER=

MOTUZ_DOCKER_ROOT=/docker

# HTTPS certificate (see README, "Set up HTTPS certificate"). By default Traefik uses
# ${MOTUZ_DOCKER_ROOT}/certs/cert.crt and cert.key. Set MOTUZ_ACME_DOMAIN to a public DNS
# name of this host to get and renew a Let's Encrypt certificate instead (port 80 must be
# reachable from the internet); the email (account contact) is optional. For testing,
# MOTUZ_ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory (remove it
# and $MOTUZ_DOCKER_ROOT/traefik/acme.json afterwards)
#MOTUZ_ACME_DOMAIN=motuz.example.org
#MOTUZ_ACME_EMAIL=admin@example.org

# Own OneDrive app registration for "Sign in with Microsoft" (see README, "OneDrive: own
# app registration"). Unset or empty: rclone's public app, where users paste the address
# of the page Microsoft redirects to. The client secret does not go here: put it in
# ${MOTUZ_DOCKER_ROOT}/secrets/MOTUZ_ONEDRIVE_CLIENT_SECRET (an empty file = not configured)
#MOTUZ_ONEDRIVE_CLIENT_ID=00000000-0000-0000-0000-000000000000
#MOTUZ_ONEDRIVE_REDIRECT_URI=https://motuz.example.org/api/oauth/onedrive/callback

# Own Google OAuth client for "Sign in with Google" (see README, "Google Drive"). Unset or
# empty: rclone's shared Drive app (being retired by rclone during 2026), where users paste
# the address of the page Google redirects to. The client secret goes in
# ${MOTUZ_DOCKER_ROOT}/secrets/MOTUZ_GDRIVE_CLIENT_SECRET (an empty file = not configured)
#MOTUZ_GDRIVE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
#MOTUZ_GDRIVE_REDIRECT_URI=https://motuz.example.org/api/oauth/gdrive/callback

# Install the Azure CLI in the app/celery images (bin/prod/build.sh), so users can create
# Azure Blob connections from their `az login` (Credentials from your home directory).
# Adds about 590 MB to the image.
#MOTUZ_INSTALL_AZURE_CLI=true
