#!/usr/bin/env bash

# Default values used by docker-compose.yml
# https://docs.docker.com/compose/environment-variables/
# Run `docker-compose config` to see substitutions

MOTUZ_DATABASE_PROTOCOL=postgresql
MOTUZ_DATABASE_NAME=motuz
MOTUZ_DATABASE_HOST=0.0.0.0:5432
MOTUZ_DATABASE_USER=motuz_user
MOTUZ_DATABASE_REQUIRE_SSL=false

MOTUZ_SMTP_SERVER=0.0.0.0:465
MOTUZ_SMTP_REQUIRE_SSL=true
MOTUZ_SMTP_USER=

MOTUZ_DOCKER_ROOT=/docker

# HTTPS certificate (see README, "Set up HTTPS certificate"). By default Traefik uses
# ${MOTUZ_DOCKER_ROOT}/certs/cert.crt and cert.key. Set MOTUZ_ACME_DOMAIN to a public DNS
# name of this host to get and renew a Let's Encrypt certificate instead (port 80 must be
# reachable from the internet); the email (account contact) is optional. For testing,
# MOTUZ_ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory (remove it
# and $MOTUZ_DOCKER_ROOT/traefik/acme.json afterwards)
#MOTUZ_ACME_DOMAIN=motuz.example.org
#MOTUZ_ACME_EMAIL=admin@example.org

# Own OneDrive app registration for "Sign in with Microsoft" (see README, "OneDrive: own
# app registration"). Unset or empty: rclone's public app, where users paste the address
# of the page Microsoft redirects to. The client secret does not go here: put it in
# ${MOTUZ_DOCKER_ROOT}/secrets/MOTUZ_ONEDRIVE_CLIENT_SECRET (an empty file = not configured)
#MOTUZ_ONEDRIVE_CLIENT_ID=00000000-0000-0000-0000-000000000000
#MOTUZ_ONEDRIVE_REDIRECT_URI=https://motuz.example.org/api/oauth/onedrive/callback

# Own Google OAuth client for "Sign in with Google" (see README, "Google Drive"). Unset or
# empty: rclone's shared Drive app (being retired by rclone during 2026), where users paste
# the address of the page Google redirects to. The client secret goes in
# ${MOTUZ_DOCKER_ROOT}/secrets/MOTUZ_GDRIVE_CLIENT_SECRET (an empty file = not configured)
#MOTUZ_GDRIVE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
#MOTUZ_GDRIVE_REDIRECT_URI=https://motuz.example.org/api/oauth/gdrive/callback

# Who operates this installation, shown on the public privacy policy (/privacy) and terms
# of service (/terms), e.g. for Google's OAuth app verification (see README, "Privacy
# policy and terms"). Unset: the pages refer to "the administrator of this Motuz
# installation". MOTUZ_OPERATOR_URL is only linked if it is an http(s) address.
#MOTUZ_OPERATOR_NAME=Example Research Institute
#MOTUZ_CONTACT_EMAIL=motuz-admin@example.org
#MOTUZ_OPERATOR_URL=https://www.example.org/

# Install the Azure CLI in the app/celery images (bin/prod/build.sh), so users can create
# Azure Blob connections from their `az login` (Credentials from your home directory).
# Adds about 590 MB to the image.
#MOTUZ_INSTALL_AZURE_CLI=true

# rclone performance (see README, "Performance tuning"). Unset or empty: rclone's own
# defaults (4 transfers, 8 checkers, 4 multi-thread streams above 256M, 16M buffer, S3
# 5M chunks x 4, Azure 4M chunks x 16), which cap a job at a few Gb/s. Users can override
# transfers, checkers, streams, cutoff and the S3/Azure chunk settings per job (New Copy
# Job dialog, "Performance"), up to the MAX_* caps and the memory budget per job:
#   transfers * (max(1, streams) * buffer_size + max(upload_concurrency, streams) * chunk_size)
# Sizes use rclone's binary units with a unit: 64M, 1G. Invalid values stop the app and
# the worker at startup with a message naming the variable.
#MOTUZ_RCLONE_TRANSFERS=16
#MOTUZ_RCLONE_CHECKERS=32
#MOTUZ_RCLONE_MULTI_THREAD_STREAMS=8
#MOTUZ_RCLONE_MULTI_THREAD_CUTOFF=128M
#MOTUZ_RCLONE_BUFFER_SIZE=16M
#MOTUZ_RCLONE_S3_UPLOAD_CONCURRENCY=8
#MOTUZ_RCLONE_S3_CHUNK_SIZE=32M
#MOTUZ_RCLONE_AZUREBLOB_UPLOAD_CONCURRENCY=16
#MOTUZ_RCLONE_AZUREBLOB_CHUNK_SIZE=16M
# Caps for per-job values (defaults shown) and the memory budget per job (default 8G)
#MOTUZ_RCLONE_MAX_TRANSFERS=64
#MOTUZ_RCLONE_MAX_CHECKERS=128
#MOTUZ_RCLONE_MAX_MULTI_THREAD_STREAMS=32
#MOTUZ_RCLONE_MAX_UPLOAD_CONCURRENCY=64
#MOTUZ_RCLONE_MEMORY_BUDGET=8G
# Admin-only extra flags, from an allowlist (README): --fast-list, --use-mmap,
# --no-traverse, --disable-http2, --s3-disable-http2, --max-buffer-memory=SIZE,
# --multi-thread-chunk-size=SIZE, --multi-thread-write-buffer-size=SIZE,
# --s3-upload-cutoff=SIZE, --s3-copy-cutoff=SIZE, --low-level-retries=N, --retries=N
#MOTUZ_RCLONE_EXTRA_FLAGS=--max-buffer-memory=32G --use-mmap

# Remote workers (see README, "Remote workers (HTTPS only)"). Unset: every job runs on this
# node. onprem: jobs with a local path wait for motuz-worker agents of the pool onprem.
#MOTUZ_LOCAL_JOB_POOL=onprem
#MOTUZ_LARGE_JOB_POOL=aws
#MOTUZ_LARGE_JOB_BYTES=300000000000
#MOTUZ_LARGE_JOB_FILES=50000
#MOTUZ_WORKER_LEASE_SECONDS=120
#MOTUZ_PUBLIC_URL=https://motuz.example.org

# Temporary EC2 workers (see README, "Temporary EC2 workers"; IAM setup in deployment/aws).
# Off by default. With true, every job of the pool aws (large cloud-to-cloud jobs,
# MOTUZ_LARGE_JOB_POOL=aws) gets its own EC2 instance, which runs the job and terminates.
# Needs MOTUZ_LARGE_JOB_POOL=aws, MOTUZ_PUBLIC_URL and MOTUZ_AWS_REGION; AWS credentials
# come from this node's instance profile.
#MOTUZ_EC2_WORKERS=true
#MOTUZ_AWS_REGION=us-west-2
# Instance type by source size (decimal units; Graviton types use the arm64 template)
#MOTUZ_EC2_INSTANCE_TYPES=1T:c7gn.large,10T:c7gn.2xlarge,*:c7gn.4xlarge
#MOTUZ_EC2_MAX_WORKERS=2
#MOTUZ_EC2_MAX_RUNTIME=24h
#MOTUZ_EC2_BOOT_TIMEOUT=20m
#MOTUZ_EC2_LAUNCH_TEMPLATE_ARM64=motuz-worker-arm64
#MOTUZ_EC2_LAUNCH_TEMPLATE_AMD64=motuz-worker
#MOTUZ_EC2_LAUNCH_TEMPLATE_VERSION='$Default'   # quoted: compose would expand $Default
#MOTUZ_EC2_SUBNET_ID=subnet-0123456789abcdef0
#MOTUZ_EC2_REAP_INTERVAL=60s
# Debugging: minutes a failed worker waits before shutting down
#MOTUZ_EC2_HALT_DELAY=0
# Where workers get Motuz: this repository at the commit the image was built from
# (bin/prod/build.sh; it must be pushed there), or a tag or commit given here
#MOTUZ_WORKER_SOURCE=https://github.com/dirkpetersen/motuz
#MOTUZ_WORKER_SOURCE_REF=
