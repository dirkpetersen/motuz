#!/usr/bin/env bash

# Default values used by docker-compose.yml
# https://docs.docker.com/compose/environment-variables/
# Run `docker-compose config` to see substitutions

MOTUZ_DATABASE_PROTOCOL=postgresql
MOTUZ_DATABASE_NAME=motuz
MOTUZ_DATABASE_HOST=0.0.0.0:5432
MOTUZ_DATABASE_USER=motuz_user
MOTUZ_DATABASE_REQUIRE_SSL=false

MOTUZ_SMTP_SERVER=0.0.0.0:465
MOTUZ_SMTP_REQUIRE_SSL=true
MOTUZ_SMTP_USER=

MOTUZ_DOCKER_ROOT=/docker

# HTTPS certificate (see README, "Set up HTTPS certificate"). By default Traefik uses
# ${MOTUZ_DOCKER_ROOT}/certs/cert.crt and cert.key. Set MOTUZ_ACME_DOMAIN to a public DNS
# name of this host to get and renew a Let's Encrypt certificate instead (port 80 must be
# reachable from the internet); the email (account contact) is optional. For testing,
# MOTUZ_ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory (remove it
# and $MOTUZ_DOCKER_ROOT/traefik/acme.json afterwards)
#MOTUZ_ACME_DOMAIN=motuz.example.org
#MOTUZ_ACME_EMAIL=admin@example.org
